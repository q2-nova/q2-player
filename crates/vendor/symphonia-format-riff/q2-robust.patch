@@ -27,6 +27,9 @@
 /// Since there are no real packets in AIFF, this is arbitrary, used same value as MP3.
 const MAX_FRAMES_PER_PACKET: u64 = 1152;
 
+/// [q2 patch] The most bytes `next_packet` reads for one packet.
+const Q2_MAX_PACKET_BYTES: u64 = 1024 * 1024;
+
 /// `ParseChunkTag` implements `parse_tag` to map between the 4-byte chunk identifier and the
 /// enumeration
 pub trait ParseChunkTag: Sized {
@@ -347,6 +350,13 @@
     let dur = blocks_per_packet * packet_info.frames_per_block;
     let packet_len = blocks_per_packet * packet_info.block_size;
 
+    // [q2 patch] The block size is a field of the file (up to 65535 bytes), and a packet is up
+    // to 1152 blocks: 72 MiB. The largest packet of real audio here is 1152 frames of eight
+    // 32-bit channels, 36 KiB.
+    if packet_len > Q2_MAX_PACKET_BYTES {
+        return decode_error("riff: packet too long");
+    }
+
     // Copy the frames.
     let packet_buf = reader.read_boxed_slice(packet_len as usize)?;
 
