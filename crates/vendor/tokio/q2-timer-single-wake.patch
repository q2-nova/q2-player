+    /// [q2 patch] The earliest registered deadline among the entries of
+    /// `slot`, or `None` when the slot is empty. Linear in the number of
+    /// entries in that one slot.
+    pub(crate) fn earliest_in_slot(&mut self, slot: usize) -> Option<u64> {
+        let mut earliest: Option<u64> = None;
+
+        self.slot[slot].for_each(|item| {
+            // SAFETY: the entry is in this wheel's list, so the caller holds
+            // the driver lock that guards `registered_when`.
+            let when = unsafe { item.registered_when() };
+            earliest = Some(earliest.map_or(when, |e| e.min(when)));
+        });
+
+        earliest
+    }
