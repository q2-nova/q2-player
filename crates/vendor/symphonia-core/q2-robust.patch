+/// [q2 patch] The most `read_boxed_slice` and `read_boxed_slice_exact` allocate before any of
+/// the requested bytes have been read.
+pub const Q2_READ_STEP: usize = 64 * 1024;
+
+/// [q2 patch] Tag values, attached pictures and other descriptive fields longer than this are
+/// skipped unread by the metadata readers and the MP4 demuxer. The player does not use embedded
+/// tags or pictures; reading a cover of several megabytes at every track start, and holding it
+/// while the track plays, cost memory and time for nothing, and a damaged length field could ask
+/// for the rest of the file.
+pub const Q2_MAX_TAG_BYTES: u64 = 64 * 1024;
