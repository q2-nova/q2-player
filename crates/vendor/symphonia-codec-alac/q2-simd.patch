--- a/src/q2prof.rs	1969-12-31 18:00:00.000000000 -0600
+++ b/src/q2prof.rs	2026-11-21 03:19:07.046458737 -0600
@@ -0,0 +1,61 @@
+// [q2 patch] Stage timers for `q2nd --bench` (docs/target-build.md#benchmarks).
+// Compiled only with `--cfg q2_alac_profile`; a normal build contains
+// none of this.
+//
+// Nanoseconds per stage accumulate in 32-bit counters (the Q2 has no 64-bit
+// atomics), enough for 4.2 s per stage. `q2::profile_take` returns and clears
+// them.
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::time::Instant;
+
+pub const STAGES: usize = 8;
+/// The whole of `decode_inner`.
+pub const PACKET: usize = 0;
+/// Clearing the output buffer.
+pub const SILENCE: usize = 1;
+/// Adaptive Rice codes.
+pub const RESIDUAL: usize = 2;
+/// Adaptive prediction.
+pub const PREDICT: usize = 3;
+/// Mid-side mixing, tail bits and the output shift.
+pub const OUTPUT: usize = 4;
+/// Element headers, tail-bit reads and uncompressed elements.
+pub const ELEMENT_OTHER: usize = 5;
+
+static NS: [AtomicU32; STAGES] = [const { AtomicU32::new(0) }; STAGES];
+static CALLS: [AtomicU32; STAGES] = [const { AtomicU32::new(0) }; STAGES];
+
+pub struct Span(usize, Instant);
+
+#[inline(always)]
+pub fn span(stage: usize) -> Span {
+    Span(stage, Instant::now())
+}
+
+impl Drop for Span {
+    #[inline(always)]
+    fn drop(&mut self) {
+        let ns = self.1.elapsed().as_nanos() as u32;
+        NS[self.0].fetch_add(ns, Ordering::Relaxed);
+        CALLS[self.0].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Stage nanoseconds, stage calls, and the mean cost of one empty span in
+/// nanoseconds (4096 spans); clears the counters.
+pub fn take() -> ([u32; STAGES], [u32; STAGES], u32) {
+    let mut ns = [0; STAGES];
+    let mut calls = [0; STAGES];
+    for i in 0..STAGES {
+        ns[i] = NS[i].swap(0, Ordering::Relaxed);
+        calls[i] = CALLS[i].swap(0, Ordering::Relaxed);
+    }
+    let t = Instant::now();
+    for _ in 0..4096 {
+        drop(span(STAGES - 1));
+    }
+    let empty = (t.elapsed().as_nanos() / 4096) as u32;
+    NS[STAGES - 1].store(0, Ordering::Relaxed);
+    CALLS[STAGES - 1].store(0, Ordering::Relaxed);
+    (ns, calls, empty)
+}
diff -ruN a/src/q2simd.rs b/src/q2simd.rs
--- a/src/q2simd.rs	1969-12-31 18:00:00.000000000 -0600
+++ b/src/q2simd.rs	2026-11-21 03:19:07.046458737 -0600
@@ -0,0 +1,211 @@
+// [q2 patch] Four-word vectors for the output kernel, and the MSA capability
+// check (README.q2.md).
+//
+// The kernel in q2fast.rs is written once over `V4`. `M4` is one MSA register
+// and exists on MIPS only, inside a `#[target_feature(enable = "msa")]` entry
+// point reached only when the kernel reports MSA (`msa()`). `P4` is the same
+// arithmetic on an array, for the unit tests.
+
+use std::sync::atomic::{AtomicU8, Ordering};
+
+/// Four 32-bit words; every operation is per word and wraps.
+pub(crate) trait V4: Copy {
+    fn splat(x: i32) -> Self;
+    /// `s[0..4]`.
+    fn load(s: &[i32]) -> Self;
+    /// To `d[0..4]`.
+    fn store(self, d: &mut [i32]);
+    fn add(self, o: Self) -> Self;
+    fn sub(self, o: Self) -> Self;
+    fn mul(self, o: Self) -> Self;
+    /// By the low five bits of `n`'s word.
+    fn shl(self, n: Self) -> Self;
+    /// Arithmetic, by the low five bits of `n`'s word.
+    fn sra(self, n: Self) -> Self;
+    fn or(self, o: Self) -> Self;
+}
+
+/// Portable vectors: the reference semantics of every `V4` operation.
+#[cfg(test)]
+#[derive(Clone, Copy)]
+pub(crate) struct P4(pub [i32; 4]);
+
+#[cfg(test)]
+impl P4 {
+    fn map2(self, o: Self, f: impl Fn(i32, i32) -> i32) -> Self {
+        P4([f(self.0[0], o.0[0]), f(self.0[1], o.0[1]), f(self.0[2], o.0[2]), f(self.0[3], o.0[3])])
+    }
+}
+
+#[cfg(test)]
+impl V4 for P4 {
+    fn splat(x: i32) -> Self {
+        P4([x; 4])
+    }
+    fn load(s: &[i32]) -> Self {
+        P4([s[0], s[1], s[2], s[3]])
+    }
+    fn store(self, d: &mut [i32]) {
+        d[..4].copy_from_slice(&self.0);
+    }
+    fn add(self, o: Self) -> Self {
+        self.map2(o, i32::wrapping_add)
+    }
+    fn sub(self, o: Self) -> Self {
+        self.map2(o, i32::wrapping_sub)
+    }
+    fn mul(self, o: Self) -> Self {
+        self.map2(o, i32::wrapping_mul)
+    }
+    fn shl(self, n: Self) -> Self {
+        self.map2(n, |a, n| a.wrapping_shl(n as u32))
+    }
+    fn sra(self, n: Self) -> Self {
+        self.map2(n, |a, n| a.wrapping_shr(n as u32))
+    }
+    fn or(self, o: Self) -> Self {
+        self.map2(o, |a, b| a | b)
+    }
+}
+
+#[cfg(target_arch = "mips")]
+pub(crate) use mips::M4;
+
+#[cfg(target_arch = "mips")]
+#[allow(unsafe_code)]
+mod mips {
+    //! Every method here runs MSA instructions. `M4` values exist only
+    //! inside the `#[target_feature(enable = "msa")]` entry point, which is
+    //! called only after `msa()` returned true; that is the safety argument
+    //! of every `unsafe` block below. The loads and stores take a
+    //! bounds-checked four-element slice; MSA's `ld.w`/`st.w` have no
+    //! alignment requirement.
+    use super::V4;
+    use core::arch::mips::*;
+    use std::mem::transmute;
+
+    /// One MSA register.
+    #[derive(Clone, Copy)]
+    pub(crate) struct M4(v4i32);
+
+    impl V4 for M4 {
+        #[inline(always)]
+        fn splat(x: i32) -> Self {
+            unsafe { M4(__msa_fill_w(x)) }
+        }
+        #[inline(always)]
+        fn load(s: &[i32]) -> Self {
+            let s = &s[..4];
+            unsafe { M4(__msa_ld_w::<0>(s.as_ptr() as *mut u8)) }
+        }
+        #[inline(always)]
+        fn store(self, dst: &mut [i32]) {
+            let dst = &mut dst[..4];
+            unsafe { __msa_st_w::<0>(self.0, dst.as_mut_ptr() as *mut u8) }
+        }
+        #[inline(always)]
+        fn add(self, o: Self) -> Self {
+            unsafe { M4(__msa_addv_w(self.0, o.0)) }
+        }
+        #[inline(always)]
+        fn sub(self, o: Self) -> Self {
+            unsafe { M4(__msa_subv_w(self.0, o.0)) }
+        }
+        #[inline(always)]
+        fn mul(self, o: Self) -> Self {
+            unsafe { M4(__msa_mulv_w(self.0, o.0)) }
+        }
+        #[inline(always)]
+        fn shl(self, n: Self) -> Self {
+            unsafe { M4(__msa_sll_w(self.0, n.0)) }
+        }
+        #[inline(always)]
+        fn sra(self, n: Self) -> Self {
+            unsafe { M4(__msa_sra_w(self.0, n.0)) }
+        }
+        #[inline(always)]
+        fn or(self, o: Self) -> Self {
+            unsafe {
+                M4(transmute::<v16u8, v4i32>(__msa_or_v(
+                    transmute::<v4i32, v16u8>(self.0),
+                    transmute::<v4i32, v16u8>(o.0),
+                )))
+            }
+        }
+    }
+}
+
+// 0: not looked up yet, 1: scalar, 2: MSA. The capability never changes
+// within a process; concurrent first callers repeat the cheap lookup.
+static MSA: AtomicU8 = AtomicU8::new(0);
+
+/// Whether the kernels use MSA: on MIPS when the kernel publishes
+/// `HWCAP_MIPS_MSA` (and `set_msa` has not turned it off), never elsewhere.
+#[inline]
+pub(crate) fn msa() -> bool {
+    match MSA.load(Ordering::Relaxed) {
+        0 => {
+            let present = detect();
+            MSA.store(if present { 2 } else { 1 }, Ordering::Relaxed);
+            present
+        }
+        state => state == 2,
+    }
+}
+
+/// `Some(false)` forces the scalar kernels, `Some(true)` asks for MSA (still
+/// only where the kernel reports it), `None` returns to the default.
+pub(crate) fn set_msa(want: Option<bool>) {
+    let state = match want {
+        None => 0,
+        Some(want) => {
+            if want && detect() {
+                2
+            }
+            else {
+                1
+            }
+        }
+    };
+    MSA.store(state, Ordering::Relaxed);
+}
+
+#[cfg(all(target_arch = "mips", target_os = "linux", not(q2_alac_no_msa)))]
+#[allow(unsafe_code)]
+fn detect() -> bool {
+    extern "C" {
+        fn getauxval(kind: std::os::raw::c_ulong) -> std::os::raw::c_ulong;
+    }
+    const AT_HWCAP: std::os::raw::c_ulong = 16;
+    // Linux MIPS UAPI: HWCAP_MIPS_MSA = 1 << 1, published when the kernel
+    // saves MSA context.
+    const HWCAP_MIPS_MSA: std::os::raw::c_ulong = 1 << 1;
+    // SAFETY: getauxval takes no pointers and only reads the process's
+    // auxiliary vector; an unknown key returns 0.
+    unsafe { getauxval(AT_HWCAP) & HWCAP_MIPS_MSA != 0 }
+}
+
+#[cfg(not(all(target_arch = "mips", target_os = "linux", not(q2_alac_no_msa))))]
+fn detect() -> bool {
+    false
+}
+
+/// xorshift32 for the generated inputs of the unit tests and `q2::selftest`.
+pub(crate) struct Rng(pub u32);
+
+impl Rng {
+    pub(crate) fn next(&mut self) -> u32 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 17;
+        self.0 ^= self.0 << 5;
+        self.0
+    }
+    /// Uniform in `0..n`.
+    pub(crate) fn below(&mut self, n: u32) -> u32 {
+        self.next() % n
+    }
+    /// A signed value of `bits` bits (1..=32).
+    pub(crate) fn signed(&mut self, bits: u32) -> i32 {
+        (self.next() as i32) >> (32 - bits)
+    }
+}
diff -ruN a/src/q2tests.rs b/src/q2tests.rs
--- a/src/q2tests.rs	1969-12-31 18:00:00.000000000 -0600
+++ b/src/q2tests.rs	2026-11-21 03:19:07.046458737 -0600
@@ -0,0 +1,296 @@
+// [q2 patch] Differential tests of the restructured decoder against
+// upstream's code (which stays in lib.rs). ALAC has few error conditions, so
+// generated element headers followed by random bits of several densities
+// decode as valid packets and exercise every code length, zero runs, escapes,
+// predictor order and mixing mode.
+
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+use symphonia_core::audio::{AudioBufferRef, Signal};
+use symphonia_core::codecs::{CodecParameters, Decoder, DecoderOptions, CODEC_TYPE_ALAC};
+use symphonia_core::formats::Packet;
+
+use super::{compare_output, output_vector};
+use crate::q2simd::{Rng, P4};
+use crate::AlacDecoder;
+
+fn output_p4(
+    out0: &mut [i32],
+    out1: &mut [i32],
+    mix_weight: i32,
+    mix_shift: u32,
+    tail: &[Vec<i32>; 2],
+    shift: u32,
+    out_shift: u32,
+) -> usize {
+    output_vector::<P4>(out0, out1, mix_weight, mix_shift, tail, shift, out_shift)
+}
+
+#[test]
+fn vector_output_matches_scalar() {
+    for seed in 1..=5u32 {
+        assert!(compare_output(Some(output_p4), seed.wrapping_mul(0x9e37_79b9), 600).unwrap() > 10_000);
+    }
+}
+
+#[test]
+fn selftest_passes() {
+    assert!(crate::q2::selftest().unwrap() > 5_000);
+}
+
+struct Writer {
+    bytes: Vec<u8>,
+    acc: u64,
+    filled: u32,
+}
+
+impl Writer {
+    fn new() -> Self {
+        Writer { bytes: Vec::new(), acc: 0, filled: 0 }
+    }
+    fn put(&mut self, value: u32, bits: u32) {
+        if bits == 0 {
+            return;
+        }
+        let value = if bits == 32 { value } else { value & ((1 << bits) - 1) };
+        self.acc = (self.acc << bits) | u64::from(value);
+        self.filled += bits;
+        while self.filled >= 8 {
+            self.bytes.push((self.acc >> (self.filled - 8)) as u8);
+            self.filled -= 8;
+        }
+    }
+}
+
+struct Stream {
+    frame_length: u32,
+    bit_depth: u8,
+    pb: u8,
+    mb: u8,
+    kb: u8,
+    channels: u8,
+}
+
+fn decoder(stream: &Stream, restructured: bool) -> AlacDecoder {
+    let mut cookie = Vec::new();
+    cookie.extend_from_slice(&stream.frame_length.to_be_bytes());
+    cookie.extend_from_slice(&[0, stream.bit_depth, stream.pb, stream.mb, stream.kb, stream.channels]);
+    cookie.extend_from_slice(&255u16.to_be_bytes());
+    cookie.extend_from_slice(&0u32.to_be_bytes());
+    cookie.extend_from_slice(&0u32.to_be_bytes());
+    cookie.extend_from_slice(&44_100u32.to_be_bytes());
+    let mut params = CodecParameters::new();
+    params.for_codec(CODEC_TYPE_ALAC).with_extra_data(cookie.into_boxed_slice());
+    let mut decoder = AlacDecoder::try_new(&params, &DecoderOptions::default()).unwrap();
+    decoder.q2_restructured = restructured;
+    decoder
+}
+
+fn random_stream(rng: &mut Rng) -> Stream {
+    let longest = if rng.below(4) == 0 { 700 } else { 90 };
+    Stream {
+        frame_length: 1 + rng.below(longest),
+        bit_depth: match rng.below(6) {
+            0 => 1 + rng.below(32) as u8,
+            1 => 24,
+            2 => 20,
+            3 => 32,
+            _ => 16,
+        },
+        pb: if rng.below(4) == 0 { rng.next() as u8 } else { 40 },
+        mb: if rng.below(4) == 0 { rng.next() as u8 } else { 10 },
+        kb: if rng.below(4) == 0 { rng.below(40) as u8 } else { 14 },
+        channels: match rng.below(5) {
+            0 => 1,
+            1 => 1 + rng.below(8) as u8,
+            _ => 2,
+        },
+    }
+}
+
+fn write_channel(w: &mut Writer, rng: &mut Rng) {
+    // Mode: 0, 15 (an extra first-order pass), rarely an invalid one.
+    w.put([0, 0, 0, 0, 0, 15, 15, 3][rng.below(8) as usize], 4);
+    w.put(if rng.below(3) == 0 { rng.below(16) } else { 9 }, 4);
+    w.put(if rng.below(3) == 0 { rng.below(8) } else { 4 }, 3);
+    let order = match rng.below(8) {
+        0 => rng.below(32),
+        1 => 0,
+        2 => 31,
+        3 => 8,
+        4 => 5,
+        5 => 6,
+        _ => 4,
+    };
+    w.put(order, 5);
+    let scale = 1 + rng.below(16);
+    for _ in 0..order {
+        w.put(rng.signed(scale) as u32, 16);
+    }
+}
+
+/// A packet for the stream; `density` selects how the entropy-coded part is filled.
+fn write_packet(rng: &mut Rng, stream: &Stream, density: u32) -> Vec<u8> {
+    let mut w = Writer::new();
+    let mut channel = 0;
+    while channel < stream.channels {
+        let cpe = stream.channels - channel >= 2 && rng.below(5) != 0;
+        match rng.below(40) {
+            0 => w.put(7, 3),
+            1 => w.put(rng.below(8), 3),
+            _ => w.put(if cpe { 1 } else if rng.below(4) == 0 { 3 } else { 0 }, 3),
+        }
+        w.put(rng.below(16), 4);
+        w.put(if rng.below(60) == 0 { 1 } else { 0 }, 12);
+        let partial = rng.below(6) == 0;
+        w.put(u32::from(partial), 1);
+        let depth = u32::from(stream.bit_depth);
+        let shift = match rng.below(4) {
+            0 if depth > 8 => 1,
+            1 if depth > 16 => 2,
+            2 if rng.below(30) == 0 => 3,
+            _ => 0,
+        };
+        w.put(shift, 2);
+        let uncompressed = rng.below(12) == 0;
+        w.put(u32::from(uncompressed), 1);
+        let frames = if partial {
+            let frames = if rng.below(20) == 0 { rng.next() } else { rng.below(stream.frame_length + 1) };
+            w.put(frames, 32);
+            frames.min(stream.frame_length)
+        }
+        else {
+            stream.frame_length
+        };
+        if !uncompressed {
+            if cpe {
+                w.put(if rng.below(20) == 0 { rng.below(256) } else { rng.below(4) }, 8);
+                w.put(if rng.below(3) == 0 { 0 } else { rng.next() }, 8);
+            }
+            else {
+                w.put(if rng.below(30) == 0 { 1 } else { 0 }, 16);
+            }
+            write_channel(&mut w, rng);
+            if cpe {
+                write_channel(&mut w, rng);
+            }
+        }
+        // Tail bits, residuals or raw samples: random bits. Sometimes too few.
+        let per_sample = 4 + rng.below(depth + 8);
+        let mut bits = frames * if cpe { 2 } else { 1 } * (per_sample + 8 * shift);
+        if rng.below(10) == 0 {
+            bits = rng.below(bits + 1);
+        }
+        for _ in 0..bits / 8 + 1 {
+            let byte = match density {
+                0 => rng.next(),
+                1 => rng.next() & rng.next(),
+                2 => rng.next() & rng.next() & rng.next() & rng.next(),
+                3 => rng.next() | rng.next(),
+                _ => {
+                    if rng.below(8) == 0 {
+                        rng.next()
+                    }
+                    else {
+                        0
+                    }
+                }
+            };
+            w.put(byte, 8);
+        }
+        channel += if cpe { 2 } else { 1 };
+    }
+    w.put(7, 3);
+    w.put(0, 7);
+    w.bytes
+}
+
+#[derive(Debug, PartialEq)]
+enum Outcome {
+    Samples(Vec<Vec<i32>>),
+    Error(String),
+}
+
+/// `None`: the decoder panicked (upstream does on arithmetic overflow and on
+/// some malformed packets when built with debug assertions).
+fn decode(decoder: &mut AlacDecoder, bytes: &[u8]) -> Option<Outcome> {
+    let packet = Packet::new_from_slice(0, 0, 0, bytes);
+    catch_unwind(AssertUnwindSafe(|| match decoder.decode(&packet) {
+        Ok(AudioBufferRef::S32(buf)) => {
+            Outcome::Samples((0..buf.spec().channels.count()).map(|c| buf.chan(c).to_vec()).collect())
+        }
+        Ok(_) => unreachable!(),
+        Err(error) => Outcome::Error(error.to_string()),
+    }))
+    .ok()
+}
+
+/// Generated packets: the same samples or the same error as upstream, and
+/// most packets decoded by the restructured code.
+#[test]
+fn packets_match_upstream() {
+    let mut rng = Rng(0xa1ac_0001);
+    let (mut compared, mut errors, mut accepted, mut panics) = (0u32, 0u32, 0u32, 0u32);
+    for round in 0..12_000u32 {
+        let stream = random_stream(&mut rng);
+        let bytes = write_packet(&mut rng, &stream, round % 5);
+        let mut theirs = decoder(&stream, false);
+        let expected = match decode(&mut theirs, &bytes) {
+            Some(expected) => expected,
+            None => {
+                panics += 1;
+                continue;
+            }
+        };
+        let mut ours = decoder(&stream, true);
+        let got = decode(&mut ours, &bytes).expect("restructured decoder panicked where upstream did not");
+        if got != expected {
+            if let (Outcome::Samples(a), Outcome::Samples(b)) = (&got, &expected) {
+                for (c, (a, b)) in a.iter().zip(b).enumerate() {
+                    if let Some(i) = (0..a.len().min(b.len())).find(|&i| a[i] != b[i]) {
+                        eprintln!("channel {} of {} samples: first difference at {}: {:#x} vs {:#x}", c, a.len(), i, a[i], b[i]);
+                    }
+                }
+            }
+            let describe = |o: &Outcome| match o {
+                Outcome::Error(e) => e.clone(),
+                Outcome::Samples(s) => format!("{} channels of {} samples", s.len(), s[0].len()),
+            };
+            panic!(
+                "round {}: {} channels, depth {}, frame {}, pb {} mb {} kb {}: ours {}, upstream {}",
+                round, stream.channels, stream.bit_depth, stream.frame_length, stream.pb, stream.mb, stream.kb,
+                describe(&got), describe(&expected)
+            );
+        }
+        compared += 1;
+        errors += u32::from(matches!(expected, Outcome::Error(_)));
+        accepted += ours.q2_accepted;
+    }
+    assert!(compared > 6000, "{} compared, {} upstream panics", compared, panics);
+    assert!(errors > 300, "{} errors of {}", errors, compared);
+    assert!(accepted > 3000, "{} of {} decoded by the restructured code", accepted, compared);
+}
+
+/// State carried between packets (the buffer's previous contents) does not leak.
+#[test]
+fn packet_sequences_match_upstream() {
+    let mut rng = Rng(0xa1ac_0002);
+    let mut compared = 0;
+    for round in 0..600u32 {
+        let stream = random_stream(&mut rng);
+        let mut ours = decoder(&stream, true);
+        let mut theirs = decoder(&stream, false);
+        for _ in 0..5 {
+            let density = rng.below(5);
+            let bytes = write_packet(&mut rng, &stream, density);
+            let expected = match decode(&mut theirs, &bytes) {
+                Some(expected) => expected,
+                None => break,
+            };
+            let got = decode(&mut ours, &bytes).expect("restructured decoder panicked where upstream did not");
+            assert!(got == expected, "round {}", round);
+            compared += 1;
+        }
+    }
+    assert!(compared > 1000, "{} compared", compared);
+}
